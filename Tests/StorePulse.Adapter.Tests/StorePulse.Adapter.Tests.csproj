<Project Sdk="Microsoft.NET.Sdk">
  <!-- The target framework comes from the host nopCommerce tree (net9.0 for 4.80/4.90, net10.0 for 5.00). -->
  <PropertyGroup><ImplicitUsings>enable</ImplicitUsings><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <!-- Same version symbol as the plugin (NOP_480, NOP_490 or NOP_500). -->
  <PropertyGroup>
    <NopCoreProjectPath>$(MSBuildProjectDirectory)\..\..\..\..\Libraries\Nop.Core\Nop.Core.csproj</NopCoreProjectPath>
    <NopVersion Condition="'$(NopVersion)' == '' And Exists('$(NopCoreProjectPath)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(NopCoreProjectPath)')), '&lt;Version&gt;(\d+\.\d+)&lt;/Version&gt;').Groups[1].Value)</NopVersion>
    <DefineConstants>$(DefineConstants);NOP_$(NopVersion.Replace('.', ''))</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Infrastructure/VersionUsings.cs" Link="VersionUsings.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <ProjectReference Include="../../Cartenvo.Plugin.Misc.StorePulse.csproj" />
  </ItemGroup>
</Project>
