@model Cartenvo.Plugin.Misc.StorePulse.Models.UpgradeModel
@using Cartenvo.Plugin.Misc.StorePulse.Models
@using Cartenvo.Plugin.Misc.StorePulse.Services
@{
    Layout = "_AdminLayout";
    ViewBag.PageTitle = T("Plugins.Misc.StorePulse.Upgrade.Title").Text;
    NopHtml.SetActiveMenuItemSystemName("Misc.StorePulse");
    const string P = "Plugins.Misc.StorePulse.";
    var total = Model.Plugins.Count;
    var percent = total == 0 ? 100 : Model.ReadyCount * 100 / total;
    var tone = percent == 100 ? "healthy" : percent >= 70 ? "warning" : "critical";
}
<partial name="~/Plugins/Misc.StorePulse/Views/_StorePulseStyles.cshtml" />

<div class="sp">
<div class="content-header clearfix">
    <h1 class="float-left"><i class="fas fa-level-up-alt"></i> @T(P + "Upgrade.Title")
        <small><i class="fas fa-arrow-circle-left"></i> <a asp-action="Configure">@T(P + "Settings.Back")</a></small>
    </h1>
</div>
<section class="content">
<div class="container-fluid">
    <div class="sp-card">
        <div class="sp-hero">
            <div class="sp-verdict">
                <div class="sp-sub">nopCommerce @Model.CurrentVersion → @Model.TargetVersion</div>
                <h2 class="@(tone)-text">@T(P + "Upgrade.Summary", Model.ReadyCount, total, Model.TargetVersion)</h2>
                <div class="sp-sub">@T(P + "Upgrade.SummaryDetail", Model.Plugins.Count(p => p.Ready), Model.Plugins.Count(p => p.Bundled && !p.Ready), Model.Plugins.Count(p => !p.Ready && !p.Bundled))</div>
                <div class="sp-bar"><i style="width:@(percent)%"></i></div>
                <p class="sp-sub mt-2 mb-0">@T(P + "Upgrade.Hint")</p>
            </div>
            <form method="get" asp-action="Upgrade" class="form-inline" style="gap:8px">
                <label for="target" class="mr-2">@T(P + "Upgrade.Target")</label>
                <select id="target" name="target" class="form-control" onchange="this.form.submit()">
                    @foreach (var option in Model.TargetOptions)
                    {
                        <option value="@option" selected="@(option == Model.TargetVersion)">@option</option>
                    }
                </select>
                <noscript><button class="btn btn-default" type="submit">OK</button></noscript>
            </form>
        </div>
    </div>

    @if (Model.ShowReadiness)
    {
        var order = new[] { ReadinessStatus.ActionNeeded, ReadinessStatus.Check, ReadinessStatus.Unknown, ReadinessStatus.Ready };
        <div class="sp-card" id="sp-readiness">
            <h3><i class="fas fa-clipboard-check"></i> @T(P + "Upgrade.Readiness.Title", Model.TargetVersion)</h3>
            <p class="sp-sub">@T(P + "Upgrade.Readiness.Hint")</p>
            <p><b>@T(P + "Upgrade.Readiness.Summary", Model.ReadinessCount(ReadinessStatus.ActionNeeded), Model.ReadinessCount(ReadinessStatus.Check), Model.ReadinessCount(ReadinessStatus.Ready))</b></p>
            @foreach (var item in Model.Readiness.OrderBy(item => Array.IndexOf(order, item.Status)))
            {
                var itemTone = UpgradeModel.Tone(item.Status);
                var problem = item.Status != ReadinessStatus.Ready;
                <div class="sp-fix" data-sp-readiness="@item.Id">
                    <i class="sp-fix-icon @UpgradeModel.Icon(item.Status) @(itemTone)-text"></i>
                    <div>
                        <b>@T(P + item.Id + ".Title")</b>
                        <span class="sp-pill @itemTone ml-1">@T(P + "Upgrade.Readiness.Status." + item.Status)</span>
                        <p class="mb-1">@T(P + item.MessageKey, item.Args)</p>
                        @if (item.Details.Count > 0)
                        {
                            <ul class="sp-sub mb-1">
                                @foreach (var detail in item.Details)
                                {
                                    <li>@detail</li>
                                }
                            </ul>
                            @if (item.MoreDetails)
                            {
                                <p class="sp-sub mb-1">@T(P + "Upgrade.Readiness.More", item.Details.Count)</p>
                            }
                        }
                        @if (problem)
                        {
                            <p class="sp-sub mb-1">@T(P + item.Id + ".Why")</p>
                            <p class="mb-1"><b>@T(P + "WhatToDo"):</b> @T(P + item.Id + ".Action")</p>
                            @if (item.AdminPath != null)
                            {
                                <div class="sp-actions">
                                    <a class="btn btn-sm btn-outline-primary" href="@Url.Content("~/" + item.AdminPath)"><i class="fas fa-external-link-alt"></i> @T(P + "OpenPage")</a>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            @if (Model.GuideUrl != null)
            {
                <p class="mb-0 mt-2"><a href="@Model.GuideUrl" target="_blank" rel="noopener"><i class="fas fa-book-open"></i> @T(P + "Upgrade.Readiness.Guide")</a></p>
            }
        </div>
        <h3 class="mt-2 mb-2" style="font-size:1.05rem;font-weight:600"><i class="fas fa-puzzle-piece"></i> @T(P + "Upgrade.Readiness.PluginsTitle")</h3>
    }

    <div class="sp-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>@T(P + "Upgrade.Status")</th><th>@T(P + "PluginName")</th><th>@T(P + "PluginVersion")</th><th>@T(P + "Upgrade.Author")</th><th>@T(P + "Upgrade.Declared")</th></tr></thead>
                <tbody>
                @foreach (var plugin in Model.Plugins)
                {
                    <tr>
                        <td>
                            @if (plugin.Ready) { <span class="sp-pill healthy"><i class="fas fa-check"></i> @T(P + "Upgrade.Ready")</span> }
                            else if (plugin.Bundled) { <span class="sp-pill muted"><i class="fas fa-box"></i> @T(P + "Upgrade.Bundled")</span> }
                            else { <span class="sp-pill warning"><i class="fas fa-exclamation-triangle"></i> @T(P + "Upgrade.NotReady")</span> }
                        </td>
                        <td><b>@plugin.FriendlyName</b><div class="sp-sub">@plugin.SystemName</div></td>
                        <td>@plugin.Version</td>
                        <td>@plugin.Author</td>
                        <td class="sp-sub">@plugin.DeclaredVersions</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</section>
</div>
