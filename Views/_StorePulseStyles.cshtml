    .sp .sp-pill.warning { background: var(--sp-warn-bg); color: var(--sp-warn); }
    .sp .sp-pill.healthy { background: var(--sp-ok-bg); color: var(--sp-ok); }
    .sp .sp-pill.muted { background: var(--sp-muted-bg); color: var(--sp-muted); }
    .sp .sp-callout { display: flex; gap: 12px; border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; border: 1px solid; }
    .sp .sp-callout.critical { background: #fef2f2; border-color: #fecaca; } .sp .sp-callout.warning { background: #fffbeb; border-color: #fde68a; }
    .sp .sp-callout i { margin-top: 3px; } .sp .sp-callout.critical i { color: var(--sp-bad); } .sp .sp-callout.warning i { color: var(--sp-warn); }
    .sp .sp-fix { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--sp-line); }
    .sp .sp-fix:first-of-type { border-top: 0; padding-top: 0; }
    .sp .sp-fix .sp-fix-icon { font-size: 1.15rem; margin-top: 2px; }
    .sp .critical-text { color: var(--sp-bad); } .sp .warning-text { color: var(--sp-warn); } .sp .healthy-text { color: var(--sp-ok); } .sp .muted-text { color: var(--sp-muted); }
    .sp .sp-fix b { display: block; } .sp .sp-fix p { margin: 2px 0 8px; font-size: .9rem; color: #475569; }
