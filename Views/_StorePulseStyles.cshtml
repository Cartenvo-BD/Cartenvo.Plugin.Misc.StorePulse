<style>
    .sp { --sp-ok: #16a34a; --sp-ok-bg: #dcfce7; --sp-warn: #d97706; --sp-warn-bg: #fef3c7;
          --sp-bad: #dc2626; --sp-bad-bg: #fee2e2; --sp-muted: #64748b; --sp-muted-bg: #f1f5f9;
          --sp-line: #e5e7eb; --sp-ink: #1f2937; --sp-soft: #f8fafc; --sp-brand: #2563eb; }
    .sp .sp-sub { color: var(--sp-muted); font-size: .9rem; }
    .sp .sp-card { background: #fff; border: 1px solid var(--sp-line); border-radius: 12px; padding: 20px; margin-bottom: 20px; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
    .sp .sp-card h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
    .sp .sp-hero { display: flex; flex-wrap: wrap; gap: 28px; align-items: center; }
    .sp .sp-ring { position: relative; width: 140px; height: 140px; flex: 0 0 140px; }
    .sp .sp-ring svg { transform: rotate(-90deg); }
    .sp .sp-ring-value { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .sp .sp-ring-value b { font-size: 2.4rem; line-height: 1; }
    .sp .sp-ring-value span { font-size: .75rem; color: var(--sp-muted); }
    .sp .sp-verdict { flex: 1 1 260px; min-width: 0; }
    .sp .sp-verdict h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 4px; }
    .sp .sp-bar { height: 6px; background: var(--sp-muted-bg); border-radius: 99px; overflow: hidden; margin-top: 6px; max-width: 320px; }
    .sp .sp-bar i { display: block; height: 100%; background: var(--sp-brand); }
    .sp .sp-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; flex: 2 1 420px; }
    .sp .sp-tile { border: 1px solid var(--sp-line); border-radius: 10px; padding: 12px 14px; background: var(--sp-soft); text-align: left; cursor: pointer; transition: transform .1s, box-shadow .1s; width: 100%; }
    .sp .sp-tile:hover { transform: translateY(-1px); box-shadow: 0 3px 10px rgba(15,23,42,.08); }
    .sp .sp-tile b { display: block; font-size: 1.7rem; line-height: 1.2; }
