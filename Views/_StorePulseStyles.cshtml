    .sp .sp-group > summary { list-style: none; cursor: pointer; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-weight: 600; background: var(--sp-soft); }
    .sp .sp-group > summary::-webkit-details-marker { display: none; }
    .sp .sp-group > summary .sp-count { margin-left: auto; display: flex; gap: 6px; }
    .sp .sp-group > summary::after { content: "\f078"; font-family: "Font Awesome 5 Free"; font-weight: 900; font-size: .75rem; color: var(--sp-muted); transition: transform .15s; }
    .sp .sp-group[open] > summary::after { transform: rotate(180deg); }
