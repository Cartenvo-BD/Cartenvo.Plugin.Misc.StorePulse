    .sp .sp-items td { vertical-align: middle; word-break: break-word; }
    .sp .sp-items .sp-id { display: block; font-size: .72rem; color: var(--sp-muted); font-family: SFMono-Regular, Consolas, monospace; }
    .sp .sp-items-note { font-size: .8rem; color: var(--sp-muted); margin: 6px 0 0; }
    .sp .sp-checklist { border: 1px solid var(--sp-line); border-radius: 8px; padding: 10px 14px; margin: 4px 0 8px 30px; }
